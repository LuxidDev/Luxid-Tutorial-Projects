{
  "name": "luxid/tutorial-authentication",
  "description": "Tutorial 03 \u2014 session authentication with Haven",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "framework",
    "starter",
    "luxid",
    "php"
  ],
  "require": {
    "php": "^8.1",
    "luxid/engine": "^0.8",
    "luxid/nova": "^0.2",
    "luxid/rocket": "^0.3",
    "vlucas/phpdotenv": "^5.6",
    "luxid/haven": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Luxid\\Framework\\": "config/"
    }
  },
  "extra": {
    "luxid": {
      "providers": [
        "Luxid\\Sentinel\\Providers\\SentinelServiceProvider"
      ],
      "commands": {
        "sentinel:install": "Luxid\\Sentinel\\Console\\InstallCommand"
      }
    }
  },
  "authors": [
    {
      "name": "Jhay",
      "email": "jhay@luxid.dev"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-create-project-cmd": [
      "php -r \"if (file_exists('.env.example') && !file_exists('.env')) copy('.env.example', '.env');\"",
      "Luxid\\Framework\\Kernel::postCreateProject"
    ]
  }
}
